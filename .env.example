# ── Google Sheets (service account) ──────────────────────────────────────────
# Locally: save the downloaded JSON key as ./service-account.json (gitignored), or point to it:
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/path/to/key.json
# On Vercel (no files): set these two from the JSON instead.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=finansial@my-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The registry: a blank sheet that stores users, books and memberships (create once per deployment).
# Every book then gets its own spreadsheet, connected from the app's "New book" wizard.
REGISTRY_SPREADSHEET_ID=
# Only for upgrading an old single-sheet setup with `pnpm migrate:multibook`; remove afterwards.
# DB_SPREADSHEET_ID=

# ── Sign-in ──────────────────────────────────────────────────────────────────
# Signs the session cookie. Generate with: npx auth secret   (or: openssl rand -base64 32)
# Users live in the registry sheet; create the first one with `pnpm user:add`.
AUTH_SECRET=

# ── Bill check: reading bill screenshots ──────────────────────────────────────
# Set one. DeepSeek (deepseek-flash) is used when both are set; VISION_PROVIDER=deepseek|kimi picks explicitly.
# Without either, bill rows can still be added by hand.
DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# VISION_PROVIDER=deepseek

# ── Library: live cursors ────────────────────────────────────────────────────
# Secret key (sk_…) from liveblocks.io. Shows where others are typing on a page, live.
# Admins can instead paste a key per book in Settings → Book (stored encrypted with AUTH_SECRET);
# that one wins. Without either, development shares cursors between tabs of one browser.
LIVEBLOCKS_SECRET_KEY=

# ── Misc ─────────────────────────────────────────────────────────────────────
# Shared secret for the daily recurring-transactions cron (Vercel sends it as a Bearer token)
CRON_SECRET=
APP_TIMEZONE=Asia/Jakarta

# Local development only: in-memory demo database with demo logins (see the login page)
# DB_DRIVER=memory
